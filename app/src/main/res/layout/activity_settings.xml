<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="#53438A"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="0.0"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:navigationIcon="@android:drawable/ic_menu_sort_by_size" />

    <ImageButton
        android:id="@+id/btnLock"
        android:layout_width="60dp"
        android:layout_height="63dp"
        android:background="@android:color/transparent"
        android:contentDescription="Замок"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="@+id/toolbar"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintVertical_bias="0.2"
        app:layout_constraintHorizontal_bias="0.0"/>

    <EditText
        android:id="@+id/editTextText"
        android:layout_width="375dp"
        android:layout_height="49dp"
        android:ems="10"
        android:hint="@string/myText"
        android:inputType="text"
        android:text=""


        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.457"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.161" />

    <EditText
        android:id="@+id/editTextDate"
        android:layout_width="371dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="text"
        android:text=""
        android:hint="@string/myText2"


        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.485"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.304" />

    <EditText
        android:hint="@string/myText3"
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="373dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="text"
        android:text=""


        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.457"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.471" />

    <!-- Делает элемент похожим на кнопку, а не на обычный чекбокс -->
    style="@style/Widget.MaterialComponents.CompoundButton.CheckBox"

    <!-- Убирает стандартный маленький квадратик слева, если нужно -->
    <!-- android:button="@null" -->

    <!-- Внутренние отступы, чтобы кнопка выглядела аккуратно -->
    android:padding="12dp" />





    app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.044"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.669" />


    />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/square_chip"
        android:layout_width="379dp"
        android:layout_height="143dp"
        android:textSize="30dp"
        android:text="Нажимая сохранить\nвы соглашаетесть\nс политикой\nконфиденциальности\nприложения"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="486dp" />



</androidx.constraintlayout.widget.ConstraintLayout>